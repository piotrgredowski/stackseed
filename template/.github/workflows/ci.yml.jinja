name: CI

on:
  push:
    branches: ["main"]
  pull_request:

jobs:
{% if backend == "none" and frontend == "none" %}
  validation:
    name: Stack-neutral validation
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
      - name: Report validation status
        run: echo "No stack-specific validators configured yet."
{% endif %}
{% if backend == "python" %}
  python:
    name: Python validation
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.14"
      - name: Set up uv
        uses: astral-sh/setup-uv@v9
      - name: Install Python dependencies
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: uv sync --dev
      - name: Run Python tests
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: uv run pytest
      - name: Run Python lint
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: uv run ruff check .
      - name: Check Python formatting
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: uv run ruff format --check .
      - name: Run Python type check
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: uv run basedpyright
{% endif %}
{% if backend == "go" %}
  go:
    name: Go validation
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version: "1.27"
          cache: true
      - name: Download Go dependencies
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: go mod download
      - name: Run Go tests
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: go test ./...
      - name: Run Go vet
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: go vet ./...
      - name: Check Go formatting
        {% if frontend == "solid_tailwind_shadcn" %}working-directory: backend
        {% endif %}run: test -z "$(gofmt -l .)"
{% endif %}
{% if frontend == "solid_tailwind_shadcn" %}
  frontend:
    name: Frontend validation
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
      - name: Set up pnpm and Node
        uses: pnpm/setup@v2
        with:
          install: false
          runtime: node@24
          version: 11.25.0
      - name: Install frontend dependencies
        {% if backend in ["python", "go"] %}working-directory: frontend
        {% endif %}run: pnpm install --frozen-lockfile=false
      - name: Run frontend type check
        {% if backend in ["python", "go"] %}working-directory: frontend
        {% endif %}run: pnpm typecheck
      - name: Run frontend tests
        {% if backend in ["python", "go"] %}working-directory: frontend
        {% endif %}run: pnpm test
      - name: Run frontend lint
        {% if backend in ["python", "go"] %}working-directory: frontend
        {% endif %}run: pnpm lint
      - name: Build frontend
        {% if backend in ["python", "go"] %}working-directory: frontend
        {% endif %}run: pnpm build
{% endif %}
